# Add this to your Project env
## Laravel Config
LOG_CHANNEL=stack
LOG_STACK=single,splunk
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

## Library Config
SPLUNK_URL=<protocol>://<host>:<port>/services/collector
SPLUNK_TOKEN=...
SPLUNK_INDEX=index_test
SPLUNK_SOURCE=source_test
SPLUNK_SSL_VERIFY=true
